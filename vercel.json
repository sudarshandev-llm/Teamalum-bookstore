{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "",
  "routes": [
    {
      "src": "/auth/callback(.*)",
      "dest": "/auth/callback.html"
    },
    {
      "src": "/admin$",
      "dest": "/admin-subscriptions.html"
    },
    {
      "src": "/admin\\.team\\.html(.*)",
      "dest": "/admin.html"
    },
    {
      "src": "/admin\\.team(.*)",
      "dest": "/admin.html"
    },
    {
      "src": "/admin(.*)",
      "dest": "/admin.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.+\\.png|.+\\.jpg|.+\\.jpeg|.+\\.svg|.+\\.ico)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}